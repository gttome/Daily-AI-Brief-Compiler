{
  "schema_version": "daily-compiler-diagram-spec-contract-v1",
  "required": [
    "schema_version",
    "story_id",
    "title",
    "subtitle",
    "producer",
    "bundle",
    "compiler",
    "evidence",
    "flow_labels"
  ],
  "constraints": {
    "schema_version": "daily-compiler-diagram-spec-v1",
    "producer_items": 4,
    "bundle_layers": 4,
    "compiler_stages": 4,
    "evidence_items": 4,
    "max_title_chars": 52,
    "max_subtitle_chars": 100,
    "no_people_or_humanoids": true,
    "no_photos": true,
    "no_freeform_coordinates": true
  }
}
