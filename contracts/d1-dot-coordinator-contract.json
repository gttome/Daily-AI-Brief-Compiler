{
  "schema_version": "daily-compiler-d1-dot-coordinator-v1",
  "role": "cloud_coordinator_only",
  "local_computer_dependency": false,
  "owner_presence_required": false,
  "responsibilities": [
    "observe_compiler_state",
    "launch_fresh_image_studio_task_when_image_specs_ready",
    "receive_six_accepted_cloud_assets_and_acceptance_manifest",
    "launch_work_cloud_porter_with_only_manifest_assets_and_repository_handoff",
    "resume_failed_porter_without_regenerating_accepted_images",
    "record_timing_usage_problem_and_outcome_events",
    "trigger_post_run_analysis"
  ],
  "prohibited": [
    "generate_images_in_persistent_dot_context",
    "make_visual_quality_decisions",
    "modify_story_semantics_during_image_transfer",
    "use_local_computer",
    "require_owner_file_transfer"
  ],
  "cloud_handoff_preference": [
    "direct_task_file_reference",
    "connected_cloud_storage"
  ],
  "zip_required": false
}
