{
  "schema_version": "daily-compiler-d1-dot-coordinator-v2",
  "role": "optional_non_image_coordinator",
  "required_for_image_path": false,
  "local_computer_dependency": false,
  "owner_presence_required": false,
  "permitted_responsibilities": [
    "observe_compiler_state",
    "record_timing_usage_problem_and_outcome_events",
    "trigger_post_run_analysis",
    "coordinate_non_image_followup_when_explicitly_configured"
  ],
  "image_path_owner": "work_cloud_browser",
  "prohibited": [
    "generate_reader_images",
    "make_reader_image_visual_quality_decisions",
    "carry_story_generation_context_between_images",
    "use_local_computer",
    "require_owner_file_transfer"
  ],
  "notes": "D1 v5 no longer depends on Dot for reader-image generation or transport. The proven path is Work Cloud Browser -> fresh ordinary ChatGPT chat per story -> exact cloud download -> Git."
}
