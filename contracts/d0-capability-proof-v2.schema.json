{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d0-capability-proof-v2.schema.json",
  "title":"Daily Compiler D0 Zero-Cost Capability Proof v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","proof_id","status","cost_boundary","runs","repeatability","formal_authorization"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d0-capability-proof-v2"},
    "proof_id":{"type":"string","minLength":1},
    "status":{"enum":["PASS","BLOCKED_RETRYABLE","FAIL"]},
    "blocker_code":{"type":["string","null"]},
    "cost_boundary":{
      "type":"object","additionalProperties":false,
      "required":["work_used","codex_used","paid_model_api_used","paid_image_service_used","billable_overage_used","new_paid_infrastructure_used","alternate_account_used","owner_image_transfer_used","owner_liveness_used"],
      "properties":{
        "work_used":{"const":false},"codex_used":{"const":false},"paid_model_api_used":{"const":false},
        "paid_image_service_used":{"const":false},"billable_overage_used":{"const":false},
        "new_paid_infrastructure_used":{"const":false},"alternate_account_used":{"const":false},
        "owner_image_transfer_used":{"const":false},"owner_liveness_used":{"const":false}
      }
    },
    "runs":{"type":"array","minItems":0,"items":{
      "type":"object","additionalProperties":false,
      "required":["run_id","story_id","packet_sha256","session_boundary","generator_submission","native_generation","canary","same_run_handoff","raw_identity"],
      "properties":{
        "run_id":{"type":"string","minLength":1},"story_id":{"type":"string","minLength":1},
        "packet_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "session_boundary":{
          "type":"object","additionalProperties":false,
          "required":["method","task_title","run_nonce","product_contract_ref","new_chat_per_run","prior_chat_context_available","prior_images_available"],
          "properties":{
            "method":{"const":"standalone_scheduled_task_new_chat"},"task_title":{"type":"string","minLength":1},
            "run_nonce":{"type":"string","minLength":1},"product_contract_ref":{"const":"https://learn.chatgpt.com/docs/automations"},
            "new_chat_per_run":{"const":true},"prior_chat_context_available":{"const":false},"prior_images_available":{"const":false}
          }
        },
        "generator_submission":{
          "type":"object","additionalProperties":false,
          "required":["prompt_path","prompt_sha256","explicit_exact_prompt","outer_canary_present_in_task_context","outer_canary_present_in_generator_prompt"],
          "properties":{
            "prompt_path":{"type":"string","minLength":1},"prompt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "explicit_exact_prompt":{"const":true},"outer_canary_present_in_task_context":{"const":true},
            "outer_canary_present_in_generator_prompt":{"const":false}
          }
        },
        "native_generation":{
          "type":"object","additionalProperties":false,
          "required":["executor","included_subscription","generated","generated_file_id"],
          "properties":{
            "executor":{"const":"chatgpt_native_images"},"included_subscription":{"const":true},"generated":{"const":true},
            "generated_file_id":{"type":"string","minLength":1}
          }
        },
        "canary":{
          "type":"object","additionalProperties":false,
          "required":["outer_probe_id","outer_probe_leakage_detected","unrelated_context_leakage_detected","story_subject_correct"],
          "properties":{
            "outer_probe_id":{"type":"string","minLength":1},"outer_probe_leakage_detected":{"const":false},
            "unrelated_context_leakage_detected":{"const":false},"story_subject_correct":{"const":true}
          }
        },
        "same_run_handoff":{
          "type":"object","additionalProperties":false,
          "required":["bridge_kind","ephemeral_file_id","raw_fetched_before_run_end","git_persisted_before_run_end","ephemeral_file_deleted"],
          "properties":{
            "bridge_kind":{"const":"connected_google_drive_ephemeral_file_shuttle"},
            "ephemeral_file_id":{"type":"string","minLength":1},"raw_fetched_before_run_end":{"const":true},
            "git_persisted_before_run_end":{"const":true},"ephemeral_file_deleted":{"const":true}
          }
        },
        "raw_identity":{
          "type":"object","additionalProperties":false,
          "required":["bytes","sha256","git_blob_sha","persisted_path","persisted_commit_sha","read_back_verified"],
          "properties":{
            "bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"persisted_path":{"type":"string","minLength":1},
            "persisted_commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"read_back_verified":{"const":true}
          }
        }
      }
    }},
    "repeatability":{
      "type":"object","additionalProperties":false,
      "required":["distinct_task_titles","distinct_run_nonces","distinct_story_packets","distinct_raw_byte_streams","minimum_successful_runs"],
      "properties":{
        "distinct_task_titles":{"type":"boolean"},"distinct_run_nonces":{"type":"boolean"},
        "distinct_story_packets":{"type":"boolean"},"distinct_raw_byte_streams":{"type":"boolean"},
        "minimum_successful_runs":{"type":"integer","minimum":0}
      }
    },
    "formal_authorization":{
      "type":"object","additionalProperties":false,
      "required":["p0_a_authorized","p0_b_authorized","may_reuse_preproof_evidence_without_regeneration"],
      "properties":{
        "p0_a_authorized":{"type":"boolean"},"p0_b_authorized":{"type":"boolean"},
        "may_reuse_preproof_evidence_without_regeneration":{"const":true}
      }
    }
  }
}