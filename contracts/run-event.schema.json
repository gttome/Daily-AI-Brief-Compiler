{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/run-event.schema.json",
  "title":"Daily Compiler Run Event v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","event_id","timestamp","edition_date","execution_id","actor","stage","event_type","status","duration_ms","refs","usage"],
  "properties":{
    "schema_version":{"const":"daily-compiler-run-event-v1"},
    "event_id":{"type":"string","minLength":1},
    "timestamp":{"type":"string","format":"date-time"},
    "edition_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "execution_id":{"type":"string","minLength":1},
    "actor":{"enum":["semantic_producer","dot","image_studio","work_porter","github_actions","compiler","recovery","correction"]},
    "stage":{"enum":["EDITORIAL","CONTENT","IMAGES","BUNDLE","COMPILE","VERIFY","CORRECTION","ANALYSIS","RESOURCE_MONITORING"]},
    "event_type":{"type":"string","minLength":1},
    "status":{"enum":["START","PASS","FAIL","BLOCKED","RETRY","INFO"]},
    "duration_ms":{"type":["integer","null"],"minimum":0},
    "refs":{"type":"array","items":{"type":"string"}},
    "problem_id":{"type":["string","null"]},
    "resource_id":{"type":["string","null"]},
    "usage":{
      "type":"object","additionalProperties":false,
      "required":["dot_active_seconds","work_active_seconds","native_image_generations","web_queries","github_writes"],
      "properties":{
        "dot_active_seconds":{"type":["number","null"],"minimum":0},
        "work_active_seconds":{"type":["number","null"],"minimum":0},
        "native_image_generations":{"type":["integer","null"],"minimum":0},
        "web_queries":{"type":["integer","null"],"minimum":0},
        "github_writes":{"type":["integer","null"],"minimum":0},
        "estimated_charge":{"type":["number","null"],"minimum":0},
        "estimate_basis":{"type":["string","null"]}
      }
    },
    "detail":{"type":["object","string","null"]}
  }
}
