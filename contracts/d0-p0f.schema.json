{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d0-p0f.schema.json",
  "title":"D0 P0-F Six-Story Native Set Proof v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","result","candidates","set_review","cost_boundary","proposal1r_reader_story_fallback_used","owner_intervention"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d0-p0-f-v1"},
    "result":{"const":"PASS"},
    "candidates":{
      "type":"array","minItems":6,"maxItems":6,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["story_id","context_id","isolated_context","raw_sha256","raw_git_blob_sha","final_sha256","final_git_blob_sha","normalized_1200x630","visual_review_v3"],
        "properties":{
          "story_id":{"type":"string","minLength":1},
          "context_id":{"type":"string","minLength":1},
          "isolated_context":{"const":true},
          "raw_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "raw_git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "final_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "final_git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "normalized_1200x630":{"const":true},
          "visual_review_v3":{"const":"PASS"}
        }
      }
    },
    "set_review":{
      "type":"object","additionalProperties":false,
      "required":["result","unique_compositions","distinct_layouts","distinct_grammars","distinct_hierarchies","distinct_annotation_patterns","unique_byte_streams","labels_swapped_template"],
      "properties":{
        "result":{"const":"PASS"},
        "unique_compositions":{"const":6},
        "distinct_layouts":{"type":"integer","minimum":4},
        "distinct_grammars":{"type":"integer","minimum":4},
        "distinct_hierarchies":{"type":"integer","minimum":4},
        "distinct_annotation_patterns":{"type":"integer","minimum":3},
        "unique_byte_streams":{"const":6},
        "labels_swapped_template":{"const":false}
      }
    },
    "cost_boundary":{"$ref":"#/$defs/cost"},
    "proposal1r_reader_story_fallback_used":{"const":false},
    "owner_intervention":{"const":false}
  },
  "$defs":{
    "cost":{
      "type":"object","additionalProperties":false,
      "required":["work_used","codex_used","paid_model_api_used","paid_image_service_used","billable_overage_used","new_paid_infrastructure_used","alternate_account_used","owner_image_transfer_used","owner_liveness_used"],
      "properties":{
        "work_used":{"const":false},"codex_used":{"const":false},"paid_model_api_used":{"const":false},
        "paid_image_service_used":{"const":false},"billable_overage_used":{"const":false},
        "new_paid_infrastructure_used":{"const":false},"alternate_account_used":{"const":false},
        "owner_image_transfer_used":{"const":false},"owner_liveness_used":{"const":false}
      }
    }
  }
}
