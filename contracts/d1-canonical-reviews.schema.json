{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-canonical-reviews.schema.json",
  "title": "Current D1 canonical product evidence",
  "description": "Digest-bound records from the already-approved separate image runtime. This envelope conveys no activation approval and performs no new generation or subjective review. image-studio/product-evidence.mjs enforces exact story, specification, acceptance, canonical/original bytes, context and immutable readback bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "execution_id",
    "contract_version",
    "manifest_sha256",
    "request",
    "source_evidence",
    "admission",
    "images",
    "observations",
    "sessions",
    "set_review",
    "binary_readback"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-d1-canonical-reviews-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "daily-compiler-image-contract-v5"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request": {
      "$ref": "#/$defs/reference"
    },
    "source_evidence": {
      "$ref": "#/$defs/reference"
    },
    "admission": {
      "$ref": "#/$defs/reference"
    },
    "images": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "image-review-v3.schema.json"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/qualityProfile"
      },
      "description": "Mandatory canonical image quality evidence; independent of optional run metrics, learning, reports and dashboards."
    },
    "sessions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "set_review": {
      "$ref": "image-set-review-v3.schema.json"
    },
    "binary_readback": {
      "type": "object",
      "required": [
        "result",
        "method",
        "commit",
        "verified_at",
        "images"
      ],
      "properties": {
        "result": {
          "const": "PASS"
        },
        "method": {
          "const": "exact_commit_raw_github_download"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "images": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "recipe_reviews": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "profile_sha256",
          "recipe_sha256",
          "criteria_sha256",
          "semantic_review_sha256",
          "specification_sha256",
          "attempts"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recipe_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "criteria_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "semantic_review_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "specification_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt",
                "raw_sha256",
                "generation_text",
                "generation_text_sha256",
                "review_request_text",
                "review_request_sha256",
                "review",
                "correction",
                "review_response_text",
                "review_response_sha256"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "raw_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "generation_text": {
                  "type": "string",
                  "minLength": 1
                },
                "generation_text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "review_request_text": {
                  "type": "string",
                  "minLength": 1
                },
                "review_request_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "review": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "story_id",
                    "specification_sha256",
                    "criteria_sha256",
                    "final_sha256",
                    "reviewer_context",
                    "reviewed_at",
                    "criteria",
                    "specification_conflict",
                    "result"
                  ],
                  "properties": {
                    "schema_version": {
                      "const": "daily-compiler-d1-recipe-review-v2"
                    },
                    "story_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "specification_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "criteria_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "final_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reviewer_context": {
                      "type": "string",
                      "pattern": "^ctx-[a-f0-9]{64}$"
                    },
                    "reviewed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "pass",
                          "location",
                          "observation",
                          "offending_text",
                          "missing_labels"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "pass": {
                            "type": "boolean"
                          },
                          "location": {
                            "type": "string",
                            "minLength": 1
                          },
                          "observation": {
                            "type": "string",
                            "minLength": 1
                          },
                          "offending_text": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "missing_labels": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    },
                    "specification_conflict": {
                      "type": "boolean"
                    },
                    "result": {
                      "enum": [
                        "PASS",
                        "FAIL"
                      ]
                    }
                  }
                },
                "correction": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "previous_review_sha256",
                        "failed_criterion_ids",
                        "text",
                        "text_sha256",
                        "criteria_sha256"
                      ],
                      "properties": {
                        "previous_review_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "failed_criterion_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "criteria_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  ]
                },
                "review_response_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                },
                "review_response_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      },
      "description": "Required by executable validators for declared profile-v2 requests; prohibited on legacy requests. Full frozen prompts and complete localized criterion observations."
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable repository-relative path confined by realpath; SHA-256 is over canonical JSON."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "qualityProfile": {
      "type": "object",
      "required": [
        "story_id",
        "canonical_sha256",
        "review_sha256",
        "context_id",
        "internal_substages",
        "secondary_relationships",
        "major_visual_regions",
        "canvas_utilization_percent",
        "dimensional_mechanism_plate",
        "white_or_near_white_background",
        "no_generic_forms",
        "no_decorative_geometry",
        "no_pseudotext",
        "story_specific_mechanism_clear",
        "premium_production_grade_textbook_editorial_finish",
        "palette_family",
        "mechanism_metaphor",
        "evidence_representation",
        "feedback_pattern"
      ],
      "properties": {
        "story_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^ctx-[a-f0-9]{64}$"
        },
        "internal_substages": {
          "type": "integer",
          "minimum": 2
        },
        "secondary_relationships": {
          "type": "integer",
          "minimum": 2
        },
        "major_visual_regions": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "canvas_utilization_percent": {
          "type": "number",
          "minimum": 80,
          "maximum": 90
        },
        "dimensional_mechanism_plate": {
          "const": true
        },
        "white_or_near_white_background": {
          "const": true
        },
        "no_generic_forms": {
          "const": true
        },
        "no_decorative_geometry": {
          "const": true
        },
        "no_pseudotext": {
          "const": true
        },
        "story_specific_mechanism_clear": {
          "const": true
        },
        "premium_production_grade_textbook_editorial_finish": {
          "const": true
        },
        "palette_family": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_metaphor": {
          "type": "string",
          "minLength": 1
        },
        "evidence_representation": {
          "type": "string",
          "minLength": 1
        },
        "feedback_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "story_id",
        "context_id",
        "prompt_sha256",
        "started_at",
        "generated_at",
        "locked_at",
        "fresh_regular_conversation",
        "temporary_chat",
        "work_mode",
        "only_own_story_prompt",
        "prior_context_reused",
        "attempts"
      ],
      "properties": {
        "story_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "pattern": "^ctx-[a-f0-9]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "locked_at": {
          "type": "string",
          "format": "date-time"
        },
        "fresh_regular_conversation": {
          "const": true
        },
        "temporary_chat": {
          "const": false
        },
        "work_mode": {
          "const": false
        },
        "only_own_story_prompt": {
          "const": true
        },
        "prior_context_reused": {
          "const": false
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "attempt",
              "context_id",
              "native_generation_completed",
              "result",
              "raw_sha256",
              "generated_at",
              "reviewed_at"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "context_id": {
                "type": "string",
                "pattern": "^ctx-[a-f0-9]{64}$"
              },
              "native_generation_completed": {
                "const": true
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "generated_at": {
                "type": "string",
                "format": "date-time"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
