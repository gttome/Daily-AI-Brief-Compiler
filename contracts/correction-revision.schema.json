{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/correction-revision.schema.json",
  "title": "Additive correction revision; immutable terminal base run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "revision_id",
    "correction_ids",
    "correction_revision",
    "status",
    "created_at",
    "base_run",
    "original_bundle_text",
    "original_bundle_sha256",
    "previous_bundle_text",
    "expected_previous_bundle_sha256",
    "predecessor_revision",
    "bundle",
    "corrections",
    "semantic_scope",
    "selected_story_ids",
    "superseded_asset_manifest",
    "new_asset_manifest",
    "preserve_original",
    "new_execution_allowed",
    "verification_receipt_path",
    "verification_receipt_sha256",
    "image_system_update"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-correction-revision-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "correction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correction_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "VALIDATED",
        "DEPLOYED",
        "LIVE_VERIFIED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_run": {
      "$ref": "compiler-state.schema.json"
    },
    "original_bundle_text": {
      "type": "string",
      "minLength": 1
    },
    "original_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_bundle_text": {
      "type": "string",
      "minLength": 1
    },
    "expected_previous_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor_revision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "record"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "record": {
              "$ref": "#"
            }
          }
        }
      ]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "digest"
      ],
      "properties": {
        "status": {
          "const": "BUNDLE_READY"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "post-publication-correction.schema.json"
      }
    },
    "semantic_scope": {
      "enum": [
        "content_only",
        "image_only",
        "media_only",
        "watchlist_only"
      ]
    },
    "selected_story_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "superseded_asset_manifest": {
      "$ref": "#/$defs/manifest"
    },
    "new_asset_manifest": {
      "$ref": "#/$defs/manifest"
    },
    "preserve_original": {
      "const": true
    },
    "new_execution_allowed": {
      "const": false
    },
    "verification_receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_system_update": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "object"
            },
            "after": {
              "type": "object"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "assets"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "LIVE_VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "verification_receipt_path": {
            "type": "string",
            "minLength": 1
          },
          "verification_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
