{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d0-activation.schema.json",
  "title":"Daily Compiler D0 Activation Receipt v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","result","strategy","contract_version","activated_at","proofs","cost_boundary","proposal1r_reader_story_fallback_used","owner_intervention"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d0-activation-v1"},
    "result":{"const":"PASS"},
    "strategy":{"const":"d0_native_image_capsules"},
    "contract_version":{"const":"daily-compiler-image-contract-v3"},
    "activated_at":{"type":"string","format":"date-time"},
    "proofs":{
      "type":"object","additionalProperties":false,
      "required":["p0_a","p0_b","p0_c","p0_d","p0_e","p0_f"],
      "properties":{
        "p0_a":{"$ref":"#/$defs/proof"},
        "p0_b":{"$ref":"#/$defs/proof"},
        "p0_c":{"$ref":"#/$defs/proof"},
        "p0_d":{"$ref":"#/$defs/proof"},
        "p0_e":{"$ref":"#/$defs/proof"},
        "p0_f":{"$ref":"#/$defs/proof"}
      }
    },
    "cost_boundary":{
      "type":"object","additionalProperties":false,
      "required":["work_used","codex_used","paid_model_api_used","paid_image_service_used","billable_overage_used","new_paid_infrastructure_used","alternate_account_used","owner_image_transfer_used","owner_liveness_used"],
      "properties":{
        "work_used":{"const":false},
        "codex_used":{"const":false},
        "paid_model_api_used":{"const":false},
        "paid_image_service_used":{"const":false},
        "billable_overage_used":{"const":false},
        "new_paid_infrastructure_used":{"const":false},
        "alternate_account_used":{"const":false},
        "owner_image_transfer_used":{"const":false},
        "owner_liveness_used":{"const":false}
      }
    },
    "proposal1r_reader_story_fallback_used":{"const":false},
    "owner_intervention":{"const":false}
  },
  "$defs":{
    "proof":{
      "type":"object","additionalProperties":false,
      "required":["result","evidence_path","evidence_sha256"],
      "properties":{
        "result":{"const":"PASS"},
        "evidence_path":{"type":"string","minLength":1},
        "evidence_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  }
}
