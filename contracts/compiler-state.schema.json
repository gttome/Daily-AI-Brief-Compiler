{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/compiler-state.schema.json",
  "title": "Daily Compiler State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "execution_id",
    "branch",
    "state",
    "stage",
    "started_at",
    "updated_at",
    "editorial_bundle",
    "images",
    "bundle",
    "last_error",
    "retryable"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-state-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "pattern": "^(?:shadow/\\d{4}-\\d{2}-\\d{2}|shadow/2026-10-09-owner-placeholder-20261009)$"
    },
    "state": {
      "enum": [
        "ALLOCATED",
        "PRODUCING",
        "BUNDLE_READY",
        "COMPILING",
        "PREVIEW_READY",
        "SHADOW_VERIFIED",
        "SHADOW_FAILED"
      ]
    },
    "stage": {
      "enum": [
        "EDITORIAL",
        "CONTENT",
        "IMAGES",
        "BUNDLE",
        "COMPILE",
        "VERIFY"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "editorial_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "accepted"
      ],
      "properties": {
        "required": {
          "const": 6
        },
        "accepted": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "strategy": {
          "enum": [
            "proposal1r_legacy",
            "d0_native_image_capsules",
            "d1_cloud_image_studio",
            "d1_work_browser_fresh_chat"
          ]
        },
        "phase": {
          "enum": [
            "PLANNED",
            "IN_PROGRESS",
            "SET_REVIEW_READY",
            "SET_PASS",
            "ACCEPTED",
            "STUDIO_RUNNING",
            "PACKAGE_ACCEPTED",
            "WORK_INGEST",
            "GITHUB_VERIFIED",
            "SPEC_READY",
            "STUDIO_REQUESTED",
            "BROWSER_RUNNING",
            "GIT_INGEST"
          ]
        },
        "set_plan_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_plan_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_review_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_review_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_porter_receipt_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_porter_receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingest_handoff_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingest_handoff_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_bound_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "strategy_contract_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "const": "images_pending"
        },
        "placeholder_id": {
          "const": "illustration-pending-1200x630-v1"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "BUNDLE_READY"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "last_error": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "preview": {
      "type": "object"
    },
    "reader_parity": {
      "type": "object"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "metrics_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "dashboard_snapshot_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problems_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_correction_id",
        "revision",
        "type",
        "status"
      ],
      "properties": {
        "active_correction_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        },
        "status": {
          "enum": [
            "VALIDATED",
            "PR_OPEN",
            "MERGED",
            "DEPLOYED",
            "VERIFIED",
            "BLOCKED"
          ]
        }
      }
    },
    "one_time_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner_authorized",
        "owner_authorization_scope",
        "historical_branch",
        "historical_commit_sha",
        "historical_execution_id",
        "historical_terminal_state",
        "historical_retryable",
        "historical_accepted_images",
        "historical_editorial_blob_sha",
        "normal_schedule_unchanged",
        "not_an_unattended_release_one_proof",
        "image_generation_disabled"
      ],
      "properties": {
        "schema_version": {
          "const": "daily-compiler-oct9-owner-placeholder-exception-v1"
        },
        "owner_authorized": {
          "const": true
        },
        "owner_authorization_scope": {
          "const": "publish_oct9_placeholders_and_provide_external_work_handoff_only"
        },
        "historical_branch": {
          "const": "shadow/2026-10-09"
        },
        "historical_commit_sha": {
          "const": "246c04d1c9761c4bb9164ce34b63833fa277dc49"
        },
        "historical_execution_id": {
          "const": "daily-compiler-shadow-2026-10-09-validation-r1"
        },
        "historical_terminal_state": {
          "const": "SHADOW_FAILED"
        },
        "historical_retryable": {
          "const": false
        },
        "historical_accepted_images": {
          "const": 0
        },
        "historical_editorial_blob_sha": {
          "const": "39489270a150dde168f43348ebce99d8a535e61f"
        },
        "normal_schedule_unchanged": {
          "const": true
        },
        "not_an_unattended_release_one_proof": {
          "const": true
        },
        "image_generation_disabled": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "images": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "images_pending"
              }
            }
          }
        },
        "required": [
          "images"
        ]
      },
      "then": {
        "properties": {
          "images": {
            "required": [
              "placeholder_id"
            ],
            "properties": {
              "accepted": {
                "maxItems": 0
              },
              "placeholder_id": {
                "const": "illustration-pending-1200x630-v1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "branch": {
            "const": "shadow/2026-10-09-owner-placeholder-20261009"
          }
        },
        "required": [
          "branch"
        ]
      },
      "then": {
        "required": [
          "one_time_recovery"
        ],
        "properties": {
          "edition_date": {
            "const": "2026-10-09"
          },
          "state": {
            "enum": [
              "BUNDLE_READY",
              "SHADOW_VERIFIED",
              "SHADOW_FAILED"
            ]
          }
        }
      }
    }
  ]
}
