{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/image-set-review-v3.schema.json",
  "title":"Daily Compiler Image Set Review v3",
  "type":"object","additionalProperties":false,
  "required":["schema_version","edition_date","candidates","observed_gate","no_labels_swapped_template","no_repeated_dominant_template","intentionally_curated","all_individually_benchmark_grade","result","reviewed_at"],
  "properties":{
    "schema_version":{"const":"daily-compiler-image-set-review-v3"},"edition_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "candidates":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["story_id","final_sha256","composition_signature","layout_signature","diagram_grammar","hierarchy_signature","annotation_pattern_signature"],"properties":{"story_id":{"type":"string","minLength":1},"final_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"composition_signature":{"type":"string","minLength":1},"layout_signature":{"type":"string","minLength":1},"diagram_grammar":{"type":"string","minLength":1},"hierarchy_signature":{"type":"string","minLength":1},"annotation_pattern_signature":{"type":"string","minLength":1}}}},
    "observed_gate":{"type":"object","additionalProperties":false,"required":["unique_compositions","distinct_layouts","distinct_grammars","distinct_hierarchies","distinct_annotation_patterns","unique_byte_streams"],"properties":{"unique_compositions":{"type":"integer","minimum":0},"distinct_layouts":{"type":"integer","minimum":0},"distinct_grammars":{"type":"integer","minimum":0},"distinct_hierarchies":{"type":"integer","minimum":0},"distinct_annotation_patterns":{"type":"integer","minimum":0},"unique_byte_streams":{"type":"integer","minimum":0}}},
    "no_labels_swapped_template":{"type":"boolean"},"no_repeated_dominant_template":{"type":"boolean"},"intentionally_curated":{"type":"boolean"},"all_individually_benchmark_grade":{"type":"boolean"},"result":{"enum":["PASS","FAIL"]},"reviewed_at":{"type":"string","format":"date-time"}
  }
}
