{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/resource-registry.schema.json",
  "title": "Daily Compiler Resource Registry v1 and Source Portfolio v2",
  "description": "Version 1 retains its original runtime fields. Version 2 adds catalogue provenance; pending imports do not authorize a new runtime route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "daily-compiler-resource-registry-v1",
        "daily-compiler-resource-registry-v2"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array"
    },
    "source_portfolio": {
      "$ref": "#/$defs/sourcePortfolio"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "daily-compiler-resource-registry-v1"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "source_portfolio"
          ]
        },
        "properties": {
          "resources": {
            "items": {
              "$ref": "#/$defs/resourceV1"
            }
          }
        }
      },
      "else": {
        "required": [
          "source_portfolio"
        ],
        "properties": {
          "resources": {
            "items": {
              "$ref": "#/$defs/resourceV2"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "last_checked_at",
        "last_success_at",
        "consecutive_failures",
        "observed_yield_rate",
        "freshness_hit_rate"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "failing",
            "unknown"
          ]
        },
        "last_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0
        },
        "observed_yield_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "freshness_hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "resourceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "name",
        "url",
        "enabled",
        "content_types",
        "priority",
        "search_mode",
        "health"
      ],
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "content_types": {
          "type": "array",
          "items": {
            "enum": [
              "article",
              "video",
              "podcast",
              "watchlist",
              "research"
            ]
          },
          "uniqueItems": true
        },
        "priority": {
          "enum": [
            "primary",
            "secondary",
            "fallback",
            "experimental"
          ]
        },
        "search_mode": {
          "enum": [
            "targeted",
            "site_search",
            "feed",
            "page",
            "manual_endpoint"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/health"
        }
      }
    },
    "resourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "name",
        "url",
        "enabled",
        "content_types",
        "priority",
        "search_mode",
        "health"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "content_types": {
          "type": "array",
          "items": {
            "enum": [
              "article",
              "video",
              "podcast",
              "watchlist",
              "research"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "priority": {
          "enum": [
            "primary",
            "secondary",
            "fallback",
            "experimental"
          ]
        },
        "search_mode": {
          "enum": [
            "targeted",
            "site_search",
            "feed",
            "page",
            "manual_endpoint"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "catalogue": {
          "$ref": "#/$defs/catalogue"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "catalogue"
            ],
            "properties": {
              "catalogue": {
                "required": [
                  "memberships"
                ],
                "properties": {
                  "memberships": {
                    "contains": {
                      "required": [
                        "resource_action"
                      ],
                      "properties": {
                        "resource_action": {
                          "const": "add_resource"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "endpoint",
              "publisher"
            ],
            "properties": {
              "enabled": {
                "const": false
              },
              "endpoint": {
                "type": "null"
              },
              "publisher": {
                "type": "null"
              },
              "search_mode": {
                "const": "manual_endpoint"
              }
            }
          }
        }
      ]
    },
    "sourcePortfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "migration_id",
        "catalogue_status",
        "applied_at",
        "source_manifest_path",
        "input_digest",
        "source_inventory_sha256",
        "source_directory_sha256",
        "baseline_registry_sha256",
        "supplied_memberships",
        "layer_membership_counts",
        "baseline_resource_ids",
        "created_resource_ids",
        "compiler_only_resource_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "daily-compiler-source-portfolio-v1"
        },
        "migration_id": {
          "const": "source-portfolio-2026-09-19-v1"
        },
        "catalogue_status": {
          "const": "reconciled"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_manifest_path": {
          "const": "migrations/source-portfolio-v1/directory.json"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_directory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "supplied_memberships": {
          "const": 204
        },
        "layer_membership_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ],
          "properties": {
            "1": {
              "const": 74
            },
            "2": {
              "const": 40
            },
            "3": {
              "const": 22
            },
            "4": {
              "const": 28
            },
            "5": {
              "const": 40
            }
          }
        },
        "baseline_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "created_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "compiler_only_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "identity",
        "qualification",
        "identity_question_ids",
        "memberships"
      ],
      "properties": {
        "migration_id": {
          "const": "source-portfolio-2026-09-19-v1"
        },
        "identity": {
          "$ref": "#/$defs/pendingIdentity"
        },
        "qualification": {
          "$ref": "#/$defs/pendingQualification"
        },
        "identity_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "memberships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/membership"
          }
        }
      }
    },
    "pendingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claimed_names",
        "canonical_publisher_id",
        "canonical_show_id",
        "verification_status",
        "evidence_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "publisher_or_channel",
            "show",
            "platform",
            "community"
          ]
        },
        "claimed_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "canonical_publisher_id": {
          "type": "null"
        },
        "canonical_show_id": {
          "type": "null"
        },
        "verification_status": {
          "const": "pending"
        },
        "evidence_ref": {
          "type": "null"
        }
      }
    },
    "pendingQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_runtime_endpoint",
        "checked_at",
        "evidence_ref",
        "unattended_eligible"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "verified_runtime_endpoint": {
          "type": "null"
        },
        "checked_at": {
          "type": "null"
        },
        "evidence_ref": {
          "type": "null"
        },
        "unattended_eligible": {
          "const": false
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_row_id",
        "layer",
        "layer_role",
        "recommended_role",
        "directory_status",
        "source_line",
        "provenance_sha256",
        "disposition",
        "resource_action",
        "baseline_runtime_role_present"
      ],
      "properties": {
        "planning_row_id": {
          "type": "string",
          "pattern": "^DIR-L[1-5]-[0-9]{3}$"
        },
        "layer": {
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "layer_role": {
          "enum": [
            "article",
            "research",
            "video",
            "podcast",
            "watchlist"
          ]
        },
        "recommended_role": {
          "type": "string",
          "minLength": 1
        },
        "directory_status": {
          "enum": [
            "Existing",
            "New"
          ]
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "provenance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "enum": [
            "mapped_existing",
            "add_resource",
            "add_layer_membership",
            "alias_requires_verification",
            "retrieval_pending"
          ]
        },
        "resource_action": {
          "enum": [
            "reuse_resource",
            "add_resource"
          ]
        },
        "baseline_runtime_role_present": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "layer": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "layer_role": {
                "const": "article"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "layer_role": {
                "const": "research"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "layer_role": {
                "const": "video"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "layer_role": {
                "const": "podcast"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "layer_role": {
                "const": "watchlist"
              }
            }
          }
        }
      ]
    }
  }
}
