{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d0-capability-proof.schema.json",
  "title":"Daily Compiler D0 Zero-Cost Capability Proof v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","proof_id","status","cost_boundary","runs","repeatability","formal_authorization"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d0-capability-proof-v1"},
    "proof_id":{"type":"string","minLength":1},
    "status":{"enum":["PASS","BLOCKED_RETRYABLE","FAIL"]},
    "blocker_code":{"type":["string","null"]},
    "cost_boundary":{
      "type":"object","additionalProperties":false,
      "required":["work_used","codex_used","paid_model_api_used","paid_image_service_used","billable_overage_used","new_paid_infrastructure_used","alternate_account_used","owner_image_transfer_used","owner_liveness_used"],
      "properties":{
        "work_used":{"const":false},"codex_used":{"const":false},"paid_model_api_used":{"const":false},
        "paid_image_service_used":{"const":false},"billable_overage_used":{"const":false},
        "new_paid_infrastructure_used":{"const":false},"alternate_account_used":{"const":false},
        "owner_image_transfer_used":{"const":false},"owner_liveness_used":{"const":false}
      }
    },
    "runs":{
      "type":"array","minItems":2,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["run_id","story_id","packet_sha256","session_boundary","native_generation","canary","same_run_handoff","raw_identity"],
        "properties":{
          "run_id":{"type":"string","minLength":1},"story_id":{"type":"string","minLength":1},
          "packet_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "session_boundary":{
            "type":"object","additionalProperties":false,
            "required":["kind","new_chat_per_run","plugin_session_id","prior_chat_context_available","prior_images_available"],
            "properties":{
              "kind":{"const":"standalone_scheduled_task"},
              "new_chat_per_run":{"const":true},"plugin_session_id":{"type":"string","minLength":1},
              "prior_chat_context_available":{"const":false},"prior_images_available":{"const":false}
            }
          },
          "native_generation":{
            "type":"object","additionalProperties":false,
            "required":["executor","included_subscription","generated"],
            "properties":{
              "executor":{"const":"chatgpt_native_images"},"included_subscription":{"const":true},"generated":{"const":true}
            }
          },
          "canary":{
            "type":"object","additionalProperties":false,
            "required":["outer_probe_id","outer_probe_visible_to_generator","other_story_material_visible","prior_image_material_visible","output_contamination_detected"],
            "properties":{
              "outer_probe_id":{"type":"string","minLength":1},
              "outer_probe_visible_to_generator":{"const":false},"other_story_material_visible":{"const":false},
              "prior_image_material_visible":{"const":false},"output_contamination_detected":{"const":false}
            }
          },
          "same_run_handoff":{
            "type":"object","additionalProperties":false,
            "required":["generated_file_id","download_url_obtained_before_capsule_end","persistence_tool_called_in_same_session","persistence_tool_session_id"],
            "properties":{
              "generated_file_id":{"type":"string","minLength":1},
              "download_url_obtained_before_capsule_end":{"const":true},
              "persistence_tool_called_in_same_session":{"const":true},
              "persistence_tool_session_id":{"type":"string","minLength":1}
            }
          },
          "raw_identity":{
            "type":"object","additionalProperties":false,
            "required":["bytes","sha256","git_blob_sha","persisted_path","persisted_commit_sha","read_back_verified"],
            "properties":{
              "bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
              "git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"persisted_path":{"type":"string","minLength":1},
              "persisted_commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"read_back_verified":{"const":true}
            }
          }
        }
      }
    },
    "repeatability":{
      "type":"object","additionalProperties":false,
      "required":["distinct_session_ids","distinct_story_packets","distinct_raw_byte_streams","minimum_successful_runs"],
      "properties":{
        "distinct_session_ids":{"const":true},"distinct_story_packets":{"const":true},"distinct_raw_byte_streams":{"const":true},
        "minimum_successful_runs":{"type":"integer","minimum":0}
      }
    },
    "formal_authorization":{
      "type":"object","additionalProperties":false,
      "required":["p0_a_authorized","p0_b_authorized","may_reuse_preproof_evidence_without_regeneration"],
      "properties":{
        "p0_a_authorized":{"type":"boolean"},"p0_b_authorized":{"type":"boolean"},
        "may_reuse_preproof_evidence_without_regeneration":{"const":true}
      }
    }
  }
}