{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/media-record.schema.json",
  "title": "Daily Compiler Media Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "id",
    "item_id",
    "source_id",
    "source",
    "source_url",
    "url",
    "title",
    "publication",
    "research_cutoff_at",
    "duration_seconds",
    "freshness_band",
    "duration_band",
    "freshness_fallback_reason",
    "duration_fallback_reason",
    "summary",
    "why_it_matters",
    "connection_to_brief",
    "related_story_ids",
    "metadata_ref",
    "support_refs",
    "reader_review_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-media-record-v1"
    },
    "type": {
      "enum": [
        "video",
        "podcast"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "metadata_ref": {
      "type": "string",
      "minLength": 1
    },
    "reader_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "summary": {
      "type": "string",
      "minLength": 24
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 24
    },
    "connection_to_brief": {
      "type": "string",
      "minLength": 24
    },
    "research_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_value",
        "precision",
        "timezone"
      ],
      "properties": {
        "original_value": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "second",
            "date"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "duration_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "original_date": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "freshness_band": {
      "enum": [
        "within_72h",
        "preferred_48h",
        "fallback_7d",
        "exceptional_30d"
      ]
    },
    "duration_band": {
      "enum": [
        "preferred_10m",
        "fallback_15m",
        "last_resort_20m",
        "no_ceiling"
      ]
    },
    "freshness_fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_story_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "support_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 6
    },
    "written_reading_time_minutes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "video"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "focus"
        ],
        "properties": {
          "duration_seconds": {
            "maximum": 1200
          },
          "freshness_band": {
            "const": "within_72h"
          },
          "duration_band": {
            "enum": [
              "preferred_10m",
              "fallback_15m",
              "last_resort_20m"
            ]
          }
        }
      },
      "else": {
        "required": [
          "written_reading_time_minutes"
        ],
        "properties": {
          "freshness_band": {
            "enum": [
              "preferred_48h",
              "fallback_7d",
              "exceptional_30d"
            ]
          },
          "duration_band": {
            "const": "no_ceiling"
          }
        }
      }
    }
  ]
}
