{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-cloud-proof-execution.schema.json",
  "title": "Daily Compiler D1 Browser Proof Execution v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "branch",
    "status",
    "request_path",
    "ingest_mapping_path",
    "native_generations",
    "owner_intervention",
    "local_computer_used",
    "updated_at"
  ],
  "properties": {
    "specification_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_sha256", "source_evidence_sha256", "source_commit", "request_commit", "source_evidence_path", "attempt_log_sha256"],
      "properties": {
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "request_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_evidence_path": {"type": "string", "minLength": 1},
        "attempt_log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "schema_version": {
      "const": "daily-compiler-d1-cloud-proof-execution-v2"
    },
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "BROWSER_RUNNING",
        "PACKAGE_ACCEPTED",
        "GIT_INGEST",
        "GITHUB_VERIFIED",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "request_path": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingest_mapping_path": {
      "type": "string",
      "minLength": 1
    },
    "ingest_handoff_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_porter_receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloud_proof_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_generations": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_assets": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "accepted_story_chats": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "owner_intervention": {
      "const": false
    },
    "local_computer_used": {
      "const": false
    },
    "last_error": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
