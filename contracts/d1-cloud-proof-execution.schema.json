{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-cloud-proof-execution.schema.json",
  "title": "Daily Compiler D1 Cloud Proof Execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "branch",
    "status",
    "studio_request_path",
    "ingest_mapping_path",
    "native_generations",
    "owner_intervention",
    "local_computer_used",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-d1-cloud-proof-execution-v1"
    },
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "STUDIO_REQUESTED",
        "STUDIO_RUNNING",
        "PACKAGE_ACCEPTED",
        "WORK_INGEST",
        "GITHUB_VERIFIED",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "studio_request_path": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingest_mapping_path": {
      "type": "string",
      "minLength": 1
    },
    "ingest_handoff_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_porter_receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloud_proof_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_generations": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_assets": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "owner_intervention": {
      "const": false
    },
    "local_computer_used": {
      "const": false
    },
    "last_error": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
