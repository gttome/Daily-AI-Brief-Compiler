{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d0-fused-live-proof.schema.json",
  "title":"D0 Fused Live Proof v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","result","proof_id","candidates","set_review","cost_boundary","proposal1r_reader_story_fallback_used","owner_intervention"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d0-fused-live-proof-v1"},
    "result":{"const":"PASS"},
    "proof_id":{"type":"string","minLength":1},
    "candidates":{
      "type":"array","minItems":6,"maxItems":6,
      "items":{
        "type":"object","additionalProperties":false,
        "required":[
          "story_id","run_id","task_title","run_nonce","packet_sha256","prompt_sha256",
          "context_id","outer_probe_id","isolated_context","outer_probe_leakage_detected",
          "unrelated_context_leakage_detected","story_subject_correct","attempt","stress_case",
          "raw_sha256","raw_git_blob_sha","final_path","final_sha256","final_git_blob_sha",
          "visual_review_path","visual_review_sha256","reviewer_identity","visual_review_v3",
          "visible_text_allowlist","observed_required_labels","missing_labels","extra_visible_text",
          "no_branding","no_logos","benchmark_grade","exact_asset_review"
        ],
        "properties":{
          "story_id":{"type":"string","minLength":1},
          "run_id":{"type":"string","minLength":1},
          "task_title":{"type":"string","minLength":1},
          "run_nonce":{"type":"string","minLength":1},
          "packet_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "prompt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "context_id":{"type":"string","minLength":1},
          "outer_probe_id":{"type":"string","minLength":1},
          "isolated_context":{"const":true},
          "outer_probe_leakage_detected":{"const":false},
          "unrelated_context_leakage_detected":{"const":false},
          "story_subject_correct":{"const":true},
          "attempt":{"type":"integer","minimum":1,"maximum":4},
          "stress_case":{"type":"boolean"},
          "raw_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "raw_git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "final_path":{"type":"string","minLength":1},
          "final_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "final_git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "visual_review_path":{"type":"string","minLength":1},
          "visual_review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "reviewer_identity":{"type":"string","minLength":1},
          "visual_review_v3":{"const":"PASS"},
          "visible_text_allowlist":{"type":"array","items":{"type":"string"},"uniqueItems":true},
          "observed_required_labels":{"type":"array","items":{"type":"string"},"uniqueItems":true},
          "missing_labels":{"type":"array","maxItems":0},
          "extra_visible_text":{"type":"array","maxItems":0},
          "no_branding":{"const":true},
          "no_logos":{"const":true},
          "benchmark_grade":{"const":true},
          "exact_asset_review":{"const":"PASS"}
        }
      }
    },
    "set_review":{
      "type":"object","additionalProperties":false,
      "required":["result","unique_compositions","distinct_layouts","distinct_grammars","distinct_hierarchies","distinct_annotation_patterns","unique_byte_streams","labels_swapped_template"],
      "properties":{
        "result":{"const":"PASS"},
        "unique_compositions":{"const":6},
        "distinct_layouts":{"type":"integer","minimum":4},
        "distinct_grammars":{"type":"integer","minimum":4},
        "distinct_hierarchies":{"type":"integer","minimum":4},
        "distinct_annotation_patterns":{"type":"integer","minimum":3},
        "unique_byte_streams":{"const":6},
        "labels_swapped_template":{"const":false}
      }
    },
    "cost_boundary":{
      "type":"object","additionalProperties":false,
      "required":["work_used","codex_used","paid_model_api_used","paid_image_service_used","billable_overage_used","new_paid_infrastructure_used","alternate_account_used","owner_image_transfer_used","owner_liveness_used"],
      "properties":{
        "work_used":{"const":false},"codex_used":{"const":false},"paid_model_api_used":{"const":false},
        "paid_image_service_used":{"const":false},"billable_overage_used":{"const":false},
        "new_paid_infrastructure_used":{"const":false},"alternate_account_used":{"const":false},
        "owner_image_transfer_used":{"const":false},"owner_liveness_used":{"const":false}
      }
    },
    "proposal1r_reader_story_fallback_used":{"const":false},
    "owner_intervention":{"const":false}
  }
}
