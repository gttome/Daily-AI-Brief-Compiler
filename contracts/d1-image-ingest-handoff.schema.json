{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-image-ingest-handoff.schema.json",
  "title":"Daily Compiler D1 Image Ingest Handoff v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","edition_date","repository","branch_mode","items","protected_pr_required","visual_quality_review_required","image_generation_allowed","owner_intervention"],
  "properties":{
    "schema_version":{"const":"daily-compiler-d1-image-ingest-handoff-v1"},
    "edition_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "repository":{"type":"string","minLength":1},
    "branch_mode":{"enum":["shadow_execution","post_publication_correction","proof"]},
    "items":{
      "type":"array","minItems":6,"maxItems":6,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["story_id","filename","target_path"],
        "properties":{
          "story_id":{"type":"string","minLength":1},
          "filename":{"type":"string","pattern":"^[^/]+\\.png$"},
          "target_path":{"type":"string","minLength":1},
          "supersedes":{"type":["object","null"]}
        }
      }
    },
    "protected_pr_required":{"const":true},
    "visual_quality_review_required":{"const":false},
    "image_generation_allowed":{"const":false},
    "owner_intervention":{"const":false}
  }
}
