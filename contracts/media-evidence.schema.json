{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/media-evidence.schema.json",
  "title": "Retained Media Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "research_cutoff_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-media-evidence-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "research_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "type",
        "item_id",
        "source_id",
        "url",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "video",
            "podcast"
          ]
        },
        "kind": {
          "enum": [
            "metadata",
            "content_support",
            "reader_value_review"
          ]
        },
        "authority": {
          "enum": [
            "publisher",
            "official_channel",
            "platform"
          ]
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "publication": {
          "$ref": "media-record.schema.json#/properties/publication"
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original_value",
            "format",
            "seconds"
          ],
          "properties": {
            "original_value": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "seconds",
                "clock",
                "iso8601"
              ]
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "original_metadata": {
          "type": "object",
          "required": [
            "type",
            "item_id",
            "source_id",
            "url",
            "source_url",
            "title",
            "source"
          ]
        },
        "source_excerpt": {
          "type": "string",
          "minLength": 80
        },
        "supports": {
          "$ref": "#/$defs/copyRationale"
        },
        "scope": {
          "const": "existing_content_pass"
        },
        "result": {
          "const": "PASS"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_copy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selected_story_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "$ref": "#/$defs/copyRationale"
        },
        "checks": {
          "type": "object",
          "required": [
            "summary_describes_content",
            "why_explains_professional_value",
            "connection_identifies_selected_coverage",
            "semantically_distinct"
          ],
          "properties": {
            "summary_describes_content": {
              "const": true
            },
            "why_explains_professional_value": {
              "const": true
            },
            "connection_identifies_selected_coverage": {
              "const": true
            },
            "semantically_distinct": {
              "const": true
            }
          }
        },
        "reviewed_evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "metadata"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "authority",
              "evidence_url",
              "retrieved_at",
              "publication",
              "duration",
              "original_metadata"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "content_support"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "authority",
              "evidence_url",
              "retrieved_at",
              "source_excerpt",
              "supports"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reader_value_review"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "scope",
              "result",
              "reviewed_at",
              "reviewed_copy_sha256",
              "selected_story_context_sha256",
              "support_refs",
              "checks",
              "rationale",
              "reviewed_evidence_sha256"
            ]
          }
        }
      ]
    },
    "copyRationale": {
      "type": "object",
      "required": [
        "summary",
        "why_it_matters",
        "connection_to_brief"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 24
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 24
        },
        "connection_to_brief": {
          "type": "string",
          "minLength": 24
        }
      }
    }
  }
}
