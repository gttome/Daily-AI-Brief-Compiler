{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/future-brief-inbox.schema.json",
  "title":"Daily Compiler Future Brief Inbox v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","updated_at","suggestions"],
