    "schema_version":{"const":"daily-compiler-future-brief-inbox-v1"},
    "updated_at":{"type":"string","format":"date-time"},
    "suggestions":{"type":"array","items":{"$ref":"future-brief-suggestion.schema.json"}}
  }
}
