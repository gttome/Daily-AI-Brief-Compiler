{
  "schema_version": "daily-compiler-editorial-contract-v1",
  "articles": {
    "count": 6,
    "focus_allocation": {
      "Technical AI Engineering": 2,
      "Applied Generative AI for Knowledge Workers": 2,
      "Agents for Everyone": 2
    },
    "agent_skills_exactly": 1,
    "freshness_hours": {
      "priority": 24,
      "normal_fallback": 72,
      "extended_fallback": 168
    },
    "reader_density": {
      "effective_edition_date": "2026-10-13",
      "reference_edition_date": "2026-10-08",
      "topics_count_exactly": 3,
      "topic_phrase_max_words": 4,
      "summary_words": {
        "min": 45,
        "max": 60
      },
      "why_it_matters_words": {
        "min": 32,
        "max": 45
      },
      "what_youll_learn_words": {
        "min": 32,
        "max": 45
      },
      "what_youll_learn_source_field": "why_it_matters",
      "historical_editions_immutable": true,
      "css_or_blind_truncation_forbidden": true
    },
    "source_diversity": {
      "effective_edition_date": "2026-10-19",
      "target_distinct_publishing_organizations": 6,
      "minimum_distinct_publishing_organizations": 5,
      "maximum_articles_per_organization": 2,
      "aws_articles_maximum": 1,
      "sap_articles_maximum": 1,
      "identity_source": "canonical organization resolved from primary source URL, not display publisher name or blog department",
      "prior_published_editions_for_research_ranking": 7,
      "never_weaken_original_source_evidence": true,
      "historical_editions_immutable": true
    },
    "editorial_novelty": {
      "effective_edition_date": "2026-10-27",
      "prior_published_editions_for_learning_value_review": 7,
      "machine_audit_source": "canonical published archive-index.json plus actual published Brief dates",
      "comparison_unit": "reader learning outcome and instruction pattern, not only headline/publisher/source URL",
      "hard_gate_repeated_generic_skill_authoring_recent_editions": 2,
      "hard_gate_near_identical_reading_explanation": true,
      "editorial_review_required_for_all_six": true,
      "routine_topic_overlap_alone_is_not_a_duplicate": true,
      "must_reselect_weak_marginal_reader_value_before_sealing": true,
      "machine_detector_is_not_a_semantic_or_source_truth_oracle": true,
      "all_earlier_editions_immutable": true,
      "validator": "scripts/verify-media-freshness.mjs at both existing protected publication gates",
      "additional_paid_services_or_schedules_allowed": false
    }
  },
  "media": {
    "videos": {
      "count": 2,
      "target_max_minutes": 10,
      "fallback_max_minutes": 20
    },
    "podcasts": {
      "count": 2,
      "source_diverse": true,
      "show_rotation": {
        "effective_edition_date": "2026-10-19",
        "distinct_programs_per_edition": 2,
        "hard_no_repeat_in_previous_published_editions": 3,
        "preferred_no_repeat_in_previous_published_editions": 7,
        "verify_by": "program name plus stable publisher show identifier when available",
        "exact_episode_repeat_lookback": 7,
        "previous_history_required": true,
        "evidence_quality_and_freshness_required": true,
        "historical_editions_immutable": true
      }
    },
    "quality_admission": {
      "effective_edition_date": "2026-10-22",
      "validator": "compiler/media-quality.mjs",
      "video_teaching_points_minimum": 3,
      "video_reproducible_procedure_alternative": true,
      "video_min_duration_seconds": 180,
      "podcast_minimum_ai_editorial_fraction": 0.75,
      "podcast_runtime_coverage_fraction_minimum": 0.9,
      "podcast_ad_seconds_excluded": true,
      "public_video_player_must_advance": true,
      "metadata_only_playback_fallback_allowed": false,
      "historical_editions_immutable": true
    }
  },
  "watchlist": {
    "required": true,
    "states": [
      "New",
      "Updated",
      "Carried forward"
    ],
    "dropped_topic_reason_required_when_applicable": true,
    "copy_contract": {
      "effective_edition_date": "2026-10-14",
      "applies_to": [
        "new",
        "updated",
        "carried_forward",
        "dropped"
      ],
      "required_item_fields": [
        "summary",
        "why_now",
        "practical_value"
      ],
      "summary_purpose": "Define the emerging technology or workflow in plain language",
      "why_now_purpose": "Describe the dated verified development or explain why a carry/retirement decision applies today",
      "practical_value_purpose": "Identify the plausible professional application or a bounded way to evaluate it; never assert demonstrated impact without evidence",
      "minimum_words_per_field": 7,
      "substantive_repeat_forbidden": true,
      "missing_copy_must_be_rewritten_by_semantic_producer": true,
      "renderer_fallback_prohibited": true,
      "earlier_editions_immutable": true
    },
    "scoring_contract": {
      "effective_edition_date": "2026-10-16",
      "applies_to": [
        "new",
        "updated"
      ],
      "required_item_field": "rubric",
      "criteria_weights": {
        "novelty": 20,
        "evidence": 25,
        "independence": 15,
        "momentum": 15,
        "relevance": 15,
        "durability": 10
      },
      "criterion_fields": [
        "score",
        "reason"
      ],
      "score": "integer 0-5 or null when unestablished",
      "minimum_reason_words": 7,
      "minimum_reason_characters": 42,
      "distinct_source_grounded_reasons_required": true,
      "uniform_three_default_forbidden": true,
      "numeric_momentum_requires": {
        "metric": "named comparable measure",
        "observations_minimum": 2,
        "observation_fields": [
          "observed_at",
          "value",
          "source_url"
        ],
        "distinct_observation_times_required": true
      },
      "unknown_momentum": null,
      "carried_forward": "Reuse last genuinely reviewed rubric by stable topic identity; if unavailable include a reviewed rubric, never generate a default",
      "computed_research_score": "reader weighted sum, null contributes zero, no renormalization",
      "preseal_validator": "node scripts/validate-semantic-bundle.mjs <state.json> <edition-bundle.json>",
      "historical_editions_immutable": true
    }
  },
  "books": {
    "reader_value": true,
    "series_coverage_required": true,
    "operational_language_forbidden": true
  },
  "images": {
    "count": 6,
    "width": 1200,
    "height": 630,
    "professional": true,
    "mechanism_oriented": true,
    "people_or_humanoids_forbidden": true,
    "low_quality_fallback_forbidden": true,
    "review_exact_persisted_asset": true,
    "accepted_regeneration_forbidden": true,
    "target_strategy": "d1_cloud_image_studio",
    "d1_quality_gate_location": "image_studio",
    "d1_github_visual_rereview_required": false,
    "d1_zip_required": false,
    "d1_work_scope": "IMAGE_PACKAGE_INGEST"
  },
  "orchestration_exclusions": [
    "Supervisor",
    "Watchdog Ring",
    "writer lease",
    "recovery lease",
    "30-task orchestration",
    "continuous AI polling",
    "wake PR",
    "runtime software repair"
  ],
  "research": {
    "resource_registry_path": "config/resource-registry.json",
    "resource_observation_required": true,
    "source_health_monitoring": true,
    "source_yield_monitoring": true,
    "large_registry_supported": true
  },
  "future_brief": {
    "inbox_path": "config/future-brief-inbox.json",
    "eligible_content_types": [
      "article",
      "story_topic",
      "image",
      "video",
      "podcast",
      "watchlist",
      "resource_source"
    ],
    "resolution_required": true,
    "editorial_validity_still_required": true
  },
  "post_publication_corrections": {
    "index_path": "config/post-publication-corrections.json",
    "supported": [
      "replace_article",
      "replace_image",
      "replace_video",
      "replace_podcast",
      "replace_watchlist_item",
      "add_watchlist_item",
      "remove_watchlist_item"
    ],
    "preserve_original": true,
    "new_execution_allowed": false,
    "protected_pr_required": true,
    "live_verification_required": true
  },
  "observability": {
    "run_events_required": true,
    "run_metrics_required": true,
    "problem_learning_required": true,
    "post_run_analysis_required": true,
    "dashboard_snapshot_required": true,
    "dot_work_time_tracking": true,
    "monetary_charge_inference_forbidden_without_rate_card": true,
    "image_generation_clock": {
      "effective_edition_date": "2026-10-22",
      "executor_observed_only": true,
      "scheduler_start_not_inferred": true
    },
    "owner_work_usage": {
      "effective_edition_date": "2026-10-22",
      "source_only": "owner_reported_in_chat",
      "per_cycle_required": true,
      "missing": "Not reported"
    }
  },
  "approved_oct20_improvements": {
    "effective_edition_date": "2026-10-21",
    "instructions": "docs/automation/OCT20_APPROVED_IMPROVEMENTS.md",
    "preseal_validator": "compiler/production-evidence.mjs",
    "chronology_required": true,
    "nontechnical_audience_fit_required": true,
    "precise_media_identity_required": true,
    "historical_editions_immutable": true
  }
}
