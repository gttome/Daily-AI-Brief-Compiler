{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/correction-verification.schema.json",
  "title": "Immutable additive correction release verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "edition_date",
    "revision_id",
    "correction_ids",
    "base_execution_id",
    "base_state_sha256",
    "original_bundle_sha256",
    "expected_previous_bundle_sha256",
    "bundle_sha256",
    "source_manifest_sha256",
    "history_merge_sha256",
    "page_url",
    "latest_edition_date",
    "historical_correction",
    "current_reader_preserved",
    "preserve_original",
    "new_execution_created",
    "recorded_at",
    "proofs"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-correction-verification-v1"
    },
    "result": {
      "const": "PASS"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "correction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "base_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_previous_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "history_merge_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "page_url": {
      "type": "string",
      "format": "uri"
    },
    "latest_edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "historical_correction": {
      "type": "boolean"
    },
    "current_reader_preserved": {
      "const": true
    },
    "preserve_original": {
      "const": true
    },
    "new_execution_created": {
      "const": false
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_revision",
        "bundle",
        "base_state",
        "original_bundle",
        "compile",
        "source_verification",
        "source_manifest",
        "built_verification",
        "live_verification",
        "history_merge"
      ],
      "properties": {
        "compiled_revision": {
          "$ref": "#/$defs/proof"
        },
        "bundle": {
          "$ref": "#/$defs/proof"
        },
        "base_state": {
          "$ref": "#/$defs/proof"
        },
        "original_bundle": {
          "$ref": "#/$defs/proof"
        },
        "compile": {
          "$ref": "#/$defs/proof"
        },
        "source_verification": {
          "$ref": "#/$defs/proof"
        },
        "source_manifest": {
          "$ref": "#/$defs/proof"
        },
        "built_verification": {
          "$ref": "#/$defs/proof"
        },
        "live_verification": {
          "$ref": "#/$defs/proof"
        },
        "history_merge": {
          "$ref": "#/$defs/proof"
        }
      }
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
