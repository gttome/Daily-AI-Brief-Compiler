{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/edition-bundle.schema.json",
  "title": "Daily Compiler Edition Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "status",
    "editorial_contract_version",
    "stories",
    "videos",
    "podcasts",
    "watchlist",
    "book_mappings",
    "images",
    "producer_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-edition-bundle-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "BUNDLE_READY"
    },
    "editorial_contract_version": {
      "const": "daily-compiler-editorial-contract-v1"
    },
    "stories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "videos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "podcasts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "watchlist": {
      "type": "object"
    },
    "book_mappings": {
      "type": "array",
      "minItems": 1
    },
    "images": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "git_blob_sha",
          "accepted"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "git_blob_sha": {
            "type": "string",
            "minLength": 40
          },
          "accepted": {
            "const": true
          }
        }
      }
    },
    "producer_receipt": {
      "type": "object"
    }
  }
}
