{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/edition-bundle.schema.json",
  "title":"Daily Compiler Edition Bundle v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","edition_date","status","editorial_contract_version","stories","videos","podcasts","watchlist","book_mappings","images","producer_receipt"],
  "properties":{
    "schema_version":{"const":"daily-compiler-edition-bundle-v1"},
    "edition_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "status":{"const":"BUNDLE_READY"},
    "editorial_contract_version":{"const":"daily-compiler-editorial-contract-v1"},
    "image_strategy":{"enum":["proposal1r_deterministic_diagram_compiler","d0_native_image_capsules"]},
    "image_acceptance":{
      "type":"object","additionalProperties":false,
      "required":["path","sha256","set_review_path","set_review_sha256","accepted_locked"],
      "properties":{
        "path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "set_review_path":{"type":"string","minLength":1},"set_review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "accepted_locked":{"const":true}
      }
    },
    "stories":{"type":"array","minItems":6,"maxItems":6},
    "videos":{"type":"array","minItems":2,"maxItems":2},
    "podcasts":{"type":"array","minItems":2,"maxItems":2},
    "watchlist":{"type":"object"},
    "book_mappings":{"type":"array","minItems":1},
    "images":{
      "type":"array","minItems":6,"maxItems":6,
      "items":{
        "type":"object",
        "required":["path","sha256","git_blob_sha","accepted"],
        "properties":{
          "story_id":{"type":"string"},"path":{"type":"string"},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "accepted":{"const":true},"accepted_locked":{"type":"boolean"},
          "asset_version":{"type":"string"},"cache_key":{"type":"string"},
          "review_path":{"type":"string"},"review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "set_review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "supersedes":{"type":["object","null"]},"visual_review":{"type":"object"}
        }
      }
    },
    "producer_receipt":{"type":"object"}
  },
  "allOf":[{
    "if":{"properties":{"image_strategy":{"const":"d0_native_image_capsules"}},"required":["image_strategy"]},
    "then":{
      "required":["image_acceptance"],
      "properties":{"images":{"items":{"required":["story_id","path","sha256","git_blob_sha","accepted","accepted_locked","asset_version","cache_key","review_path","review_sha256","set_review_sha256","supersedes"]}}}
    }
  }]
}
