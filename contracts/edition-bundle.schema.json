{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/edition-bundle.schema.json",
  "title": "Daily Compiler Edition Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "status",
    "editorial_contract_version",
    "stories",
    "videos",
    "podcasts",
    "watchlist",
    "book_mappings",
    "images",
    "producer_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-edition-bundle-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "BUNDLE_READY"
    },
    "editorial_contract_version": {
      "const": "daily-compiler-editorial-contract-v1"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "stories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "headline",
          "focus",
          "summary",
          "why_it_matters",
          "source",
          "reading_time_minutes",
          "topics",
          "coverage_labels",
          "related_coverage",
          "image_alt",
          "agent_skills",
          "permanent_route"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "enum": [
              "Technical AI Engineering",
              "Applied Generative AI for Knowledge Workers",
              "Agents for Everyone"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "title",
              "publisher",
              "url",
              "published_at"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "published_at": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            }
          },
          "reading_time_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "coverage_labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "related_coverage": {
            "type": "string",
            "minLength": 1
          },
          "image_alt": {
            "type": "string",
            "minLength": 1
          },
          "agent_skills": {
            "type": "boolean"
          },
          "permanent_route": {
            "type": "string",
            "pattern": "^/stories/\\d{4}-\\d{2}-\\d{2}/[^/]+/$"
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title",
          "source",
          "url",
          "published_at",
          "duration_minutes",
          "focus",
          "summary",
          "why_it_matters",
          "verified"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 20
          },
          "focus": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "verified": {
            "const": true
          }
        }
      }
    },
    "podcasts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title",
          "source",
          "url",
          "published_at",
          "duration_minutes",
          "written_reading_time_minutes",
          "summary",
          "why_it_matters",
          "verified"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "written_reading_time_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "verified": {
            "const": true
          }
        }
      }
    },
    "watchlist": {
      "type": "object",
      "required": [
        "new",
        "updated",
        "carried_forward",
        "dropped"
      ],
      "properties": {
        "new": {
          "type": "array",
          "minItems": 1
        },
        "updated": {
          "type": "array",
          "minItems": 1
        },
        "carried_forward": {
          "type": "array",
          "minItems": 1
        },
        "dropped": {
          "type": "array"
        }
      }
    },
    "book_mappings": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "story_id",
          "book",
          "connection",
          "what_to_study_next"
        ],
        "properties": {
          "story_id": {
            "type": "string"
          },
          "book": {
            "type": "string"
          },
          "concept_or_chapter": {
            "type": "string"
          },
          "connection": {
            "type": "string"
          },
          "what_to_study_next": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "story_id",
          "path",
          "sha256",
          "git_blob_sha",
          "accepted",
          "visual_review"
        ],
        "properties": {
          "story_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "accepted": {
            "const": true
          },
          "visual_review": {
            "type": "object",
            "required": [
              "result",
              "reviewed_sha256"
            ],
            "properties": {
              "result": {
                "const": "PASS"
              },
              "reviewed_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "producer_receipt": {
      "type": "object"
    }
  }
}
