{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/edition-bundle.schema.json",
  "title": "Daily Compiler Edition Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "status",
    "editorial_contract_version",
    "stories",
    "videos",
    "podcasts",
    "watchlist",
    "book_mappings",
    "images",
    "producer_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-edition-bundle-v1"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "BUNDLE_READY"
    },
    "editorial_contract_version": {
      "const": "daily-compiler-editorial-contract-v1"
    },
    "stories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "videos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "podcasts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "watchlist": {
      "type": "object"
    },
    "book_mappings": {
      "type": "array",
      "minItems": 1
    },
    "image_system": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "contract_version",
            "set_plan_path",
            "set_plan_sha256",
            "set_review_path",
            "set_review_sha256",
            "acceptance_path",
            "acceptance_sha256"
          ],
          "properties": {
            "strategy": {
              "const": "d0_native_image_capsules"
            },
            "contract_version": {
              "const": "daily-compiler-image-contract-v3"
            },
            "set_plan_path": {
              "type": "string",
              "minLength": 1
            },
            "set_plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "set_review_path": {
              "type": "string",
              "minLength": 1
            },
            "set_review_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "acceptance_path": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "contract_version",
            "acceptance_manifest_path",
            "acceptance_manifest_sha256",
            "work_porter_receipt_path",
            "work_porter_receipt_sha256"
          ],
          "properties": {
            "strategy": {
              "const": "d1_cloud_image_studio"
            },
            "contract_version": {
              "const": "daily-compiler-image-contract-v4"
            },
            "acceptance_manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "work_porter_receipt_path": {
              "type": "string",
              "minLength": 1
            },
            "work_porter_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "images": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "git_blob_sha",
          "accepted"
        ],
        "properties": {
          "story_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "accepted": {
            "const": true
          },
          "accepted_locked": {
            "type": "boolean"
          },
          "image_system": {
            "type": "string"
          },
          "asset_version": {
            "type": "string"
          },
          "cache_key": {
            "type": "string"
          },
          "supersedes": {
            "type": [
              "object",
              "null"
            ]
          },
          "packet_path": {
            "type": "string"
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "admission_path": {
            "type": "string"
          },
          "admission_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_receipt_path": {
            "type": "string"
          },
          "raw_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "final_receipt_path": {
            "type": "string"
          },
          "final_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "structural_gate_path": {
            "type": "string"
          },
          "structural_gate_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "visual_review_path": {
            "type": "string"
          },
          "visual_review_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "set_review_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "visual_review": {
            "type": "object"
          }
        }
      }
    },
    "producer_receipt": {
      "type": "object"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "correction_id",
          "correction_type",
          "correction_revision",
          "reason",
          "preserve_original"
        ],
        "properties": {
          "correction_id": {
            "type": "string"
          },
          "correction_type": {
            "type": "string"
          },
          "correction_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          },
          "preserve_original": {
            "const": true
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "image_system"
        ],
        "properties": {
          "image_system": {
            "properties": {
              "strategy": {
                "const": "d0_native_image_capsules"
              }
            },
            "required": [
              "strategy"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "items": {
              "required": [
                "story_id",
                "accepted_locked",
                "image_system",
                "asset_version",
                "cache_key",
                "supersedes",
                "packet_path",
                "packet_sha256",
                "admission_path",
                "admission_sha256",
                "raw_receipt_path",
                "raw_receipt_sha256",
                "final_receipt_path",
                "final_receipt_sha256",
                "structural_gate_path",
                "structural_gate_sha256",
                "visual_review_path",
                "visual_review_sha256",
                "set_review_sha256"
              ],
              "properties": {
                "accepted_locked": {
                  "const": true
                },
                "image_system": {
                  "const": "d0_native_image_capsules"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "image_system"
        ],
        "properties": {
          "image_system": {
            "properties": {
              "strategy": {
                "const": "d1_cloud_image_studio"
              }
            },
            "required": [
              "strategy"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "items": {
              "required": [
                "story_id",
                "accepted_locked",
                "image_system",
                "asset_version",
                "cache_key",
                "supersedes"
              ],
              "properties": {
                "accepted_locked": {
                  "const": true
                },
                "image_system": {
                  "const": "d1_cloud_image_studio"
                }
              }
            }
          }
        }
      }
    }
  ]
}
