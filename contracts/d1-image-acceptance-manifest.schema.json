{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-image-acceptance-manifest.schema.json",
  "title": "Daily Compiler D1 Image Acceptance Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "studio_session_id",
    "accepted_at",
    "quality_gate_location",
    "github_visual_rereview_required",
    "set_review",
    "images",
    "owner_intervention"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-d1-image-acceptance-manifest-v2"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "studio_session_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_gate_location": {
      "const": "fresh_regular_chat_per_story"
    },
    "github_visual_rereview_required": {
      "const": false
    },
    "set_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "unique_compositions",
        "unique_byte_streams",
        "unique_story_chats",
        "distinct_layouts",
        "distinct_mechanisms"
      ],
      "properties": {
        "result": {
          "const": "PASS"
        },
        "unique_compositions": {
          "const": 6
        },
        "unique_byte_streams": {
          "const": 6
        },
        "unique_story_chats": {
          "const": 6
        },
        "distinct_layouts": {
          "type": "integer",
          "minimum": 4
        },
        "distinct_mechanisms": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "chat_session_id",
          "cloud_asset_id",
          "filename",
          "width",
          "height",
          "format",
          "bytes",
          "sha256",
          "composition_signature",
          "visible_text_allowlist",
          "attempt",
          "visual_acceptance",
          "accepted_locked"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "minLength": 1
          },
          "chat_session_id": {
            "type": "string",
            "minLength": 1
          },
          "cloud_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/]+\\.png$"
          },
          "width": {
            "const": 1200
          },
          "height": {
            "const": 630
          },
          "format": {
            "const": "png"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "composition_signature": {
            "type": "string",
            "minLength": 1
          },
          "visible_text_allowlist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "visual_acceptance": {
            "const": "PASS"
          },
          "accepted_locked": {
            "const": true
          },
          "supersedes": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "owner_intervention": {
      "const": false
    }
  }
}
