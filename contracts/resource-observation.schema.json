{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/resource-observation.schema.json",
  "title": "Daily Compiler Resource Observation v1 and v2",
  "description": "V1 remains historical input. V2 separates access health, editorial yield and due coverage. Unknown elapsed time is null; healthy empty responses are not failures. Cross-field counter/order and outcome checks are enforced by validateResourceObservation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "execution_id",
    "resource_id",
    "checked_at",
    "content_type",
    "queries",
    "candidates_found",
    "usable_candidates",
    "selected_items",
    "fresh_items",
    "failures",
    "duration_ms"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "daily-compiler-resource-observation-v1",
        "daily-compiler-resource-observation-v2"
      ]
    },
    "edition_date": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_type": {
      "enum": [
        "article",
        "video",
        "podcast",
        "watchlist",
        "research"
      ]
    },
    "queries": {
      "type": "integer",
      "minimum": 0
    },
    "candidates_found": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "usable_candidates": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "selected_items": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fresh_items": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "http_status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "access_blocked",
            "parse_error",
            "identity_unverified",
            "unavailable",
            "not_checked"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "due"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "not_due",
            "pending",
            "budget_skipped"
          ]
        },
        "due": {
          "type": "boolean"
        }
      }
    },
    "editorial_yield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "empty",
            "no_fresh_items",
            "candidates"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "daily-compiler-resource-observation-v1"
          }
        }
      },
      "then": {
        "properties": {
          "candidates_found": {
            "type": "integer",
            "minimum": 0
          },
          "usable_candidates": {
            "type": "integer",
            "minimum": 0
          },
          "selected_items": {
            "type": "integer",
            "minimum": 0
          },
          "fresh_items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "retrieval"
              ]
            },
            {
              "required": [
                "coverage"
              ]
            },
            {
              "required": [
                "editorial_yield"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "retrieval",
          "coverage",
          "editorial_yield"
        ]
      }
    }
  ]
}
