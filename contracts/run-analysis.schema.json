{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/run-analysis.schema.json",
  "title":"Daily Compiler Post-Run Analysis v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","edition_date","execution_id","result","timing_summary","quality_summary","resource_summary","cost_efficiency","problems","improvements"],
  "properties":{
    "schema_version":{"const":"daily-compiler-run-analysis-v1"},
    "edition_date":{"type":"string"},
    "execution_id":{"type":"string"},
    "result":{"enum":["PASS","PASS_WITH_ISSUES","FAIL"]},
    "timing_summary":{"type":"object"},
    "quality_summary":{"type":"object"},
    "resource_summary":{"type":"object"},
    "cost_efficiency":{"type":"object"},
    "problems":{"type":"array"},
    "improvements":{"type":"array","items":{
      "type":"object","required":["priority","area","recommendation","expected_benefit","implementation_scope"],
      "properties":{
        "priority":{"enum":["P0","P1","P2","P3"]},
        "area":{"enum":["speed","reliability","quality","research","sources","image_generation","work_time","dot_time","github","ci","deployment","corrections","cost","dashboard","other"]},
        "recommendation":{"type":"string"},
        "expected_benefit":{"type":"string"},
        "implementation_scope":{"enum":["next_run","system_hardening","monitor","backlog"]}
      }
    }}
  }
}
