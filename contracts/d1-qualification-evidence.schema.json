{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-qualification-evidence.schema.json",
  "title": "D1 durable qualification evidence v1",
  "description": "A companion evidence manifest; no runtime state machine or activation authority. Referenced records and canonical PNGs must remain immutable and public-safe. Semantic cross-bindings are enforced by image-studio/proof-evidence.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "state",
    "manifest",
    "handoff",
    "porter",
    "request",
    "source_evidence",
    "attempt_log",
    "admission",
    "quality_contract",
    "runtime",
    "canonical_reviews",
    "binary_readback",
    "resume",
    "set_review"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-d1-qualification-evidence-v1"
    },
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "$ref": "#/$defs/reference"
    },
    "manifest": {
      "$ref": "#/$defs/reference"
    },
    "handoff": {
      "$ref": "#/$defs/reference"
    },
    "porter": {
      "$ref": "#/$defs/reference"
    },
    "request": {
      "$ref": "#/$defs/reference"
    },
    "source_evidence": {
      "$ref": "#/$defs/reference"
    },
    "attempt_log": {
      "$ref": "#/$defs/reference"
    },
    "admission": {
      "$ref": "#/$defs/reference"
    },
    "quality_contract": {
      "$ref": "#/$defs/reference"
    },
    "runtime": {
      "$ref": "#/$defs/reference"
    },
    "canonical_reviews": {
      "$ref": "#/$defs/reference"
    },
    "binary_readback": {
      "$ref": "#/$defs/reference"
    },
    "resume": {
      "$ref": "#/$defs/reference"
    },
    "set_review": {
      "$ref": "#/$defs/reference"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative immutable artifact; traversal and outside-checkout symlinks are rejected."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "description": "Required on request and resume checkpoint references; binary readback records also require the exact immutable download commit."
        }
      }
    }
  }
}

