{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief-Compiler/contracts/d1-ingest-handoff.schema.json",
  "title": "Daily Compiler D1 Image Ingest Handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_date",
    "execution_id",
    "repository",
    "branch",
    "manifest_sha256",
    "items",
    "scope",
    "visual_rereview_required",
    "image_generation_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-compiler-d1-ingest-handoff-v2"
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "const": "IMAGE_BROWSER_ORCHESTRATION_AND_INGEST"
    },
    "visual_rereview_required": {
      "const": false
    },
    "image_generation_allowed": {
      "const": false
    },
    "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "filename",
          "target_path"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/]+\\.png$"
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
